# Optional local PostgreSQL preparation. The demo does not read these variables.
# Copy to .env only when using Docker; replace the example password locally.
POSTGRES_USER=rotex
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=rotex_dev
POSTGRES_PORT=5432

# Reserved for C01 (Prisma); keep this aligned with the values above.
# URL-encode special characters in credentials. Never use NEXT_PUBLIC_ here.
DATABASE_URL=postgresql://rotex:replace-with-a-local-password@127.0.0.1:5432/rotex_dev?schema=public
